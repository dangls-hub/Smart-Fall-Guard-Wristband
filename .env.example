# Copy to repository root .env. Never commit credentials.
# Match MQTT_PASSWORD with the backend password set via mosquitto_passwd.
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_PROTOCOL=mqtt
MQTT_USERNAME=fallguard_backend
MQTT_PASSWORD=replace_with_backend_password
# TLS: mqtts, port 8883, hostname/IP matching certificate SAN.
# mqtts requires a readable CA; relative paths resolve from repository root.
MQTT_CA_PATH=./certs/ca.crt
# Required by TLS override; replace with the server's actual LAN IP.
MQTT_BIND_ADDRESS=127.0.0.1

# PostgreSQL is the selected database. db_helper remains to be implemented.
POSTGRES_DB=fallguard_db
POSTGRES_USER=fallguard
POSTGRES_PASSWORD=replace_with_database_password
DB_HOST=localhost
DB_PORT=5432

HOST=127.0.0.1
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Optional alert providers, not yet implemented.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=
