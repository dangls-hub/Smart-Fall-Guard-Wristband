# ==========================================================
# CẤU HÌNH HỆ THỐNG SMART FALL-GUARD WRISTBAND (NHÓM 4 - GEHIHI)
# ==========================================================

# 1. MQTT Broker Configuration
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TLS_PORT=8883
MQTT_WS_PORT=9001
MQTT_USERNAME=fallguard_backend
MQTT_PASSWORD=your_secure_password_here

# 2. Database Configuration
DB_URL=postgres://postgres:postgres@localhost:5432/fallguard_db
SQLITE_PATH=./database/fallguard.sqlite

# 3. Backend Server Configuration
PORT=5000
CORS_ORIGIN=http://localhost:5173

# 4. Multi-channel Webhook Alert (Telegram Bot & Email)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_family_group_chat_id
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_alert_email@gmail.com
SMTP_PASS=your_app_specific_password
